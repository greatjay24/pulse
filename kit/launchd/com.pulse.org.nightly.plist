<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.pulse.org.nightly</string>
  <key>ProgramArguments</key>
  <array><string>{{PYTHON}}</string><string>{{ORG}}/bin/nightly.py</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>{{ORG}}/logs/launchd.out</string>
  <key>StandardErrorPath</key><string>{{ORG}}/logs/launchd.err</string>
</dict></plist>
